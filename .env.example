POSTGRES_DB=sedeagro
POSTGRES_USER=sedeagro
POSTGRES_PASSWORD=sedeagro_dev_password
# Production runtime user must differ from POSTGRES_USER and must not own the schema.
APP_DB_USER=sedeagro_app
# Generate a unique 24+ character URL-safe password (letters/numbers/dot/underscore/tilde/hyphen).
APP_DB_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=3000
JWT_SECRET=change-me-in-production
SEED_MODE=dev
# Opt-in: set SEED_MODE=demo and a secret 12+ character password for isolated demo data.
DEMO_PASSWORD=
LOG_LEVEL=debug
LOG_SQL=0
LOG_STACK=0
LOG_FORMAT=text # text o json

